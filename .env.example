# Google Sheets lead database (server-side only; never add NEXT_PUBLIC_).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the JSON key's private_key value. Literal \n sequences are converted to newlines.
GOOGLE_PRIVATE_KEY=

# Optional WhatsApp Business Cloud API webhook scaffolding.
# The webhook remains disabled until all four values and Google Sheets credentials are set.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
